# Browser-visible configuration. Copy to `.env.local`, which Git ignores.
#
# Every value here is inlined into the client bundle and is public by design.
# Never place a private key, mnemonic, or API secret in this file.

# Read-only Monad Testnet RPC endpoint used by the browser.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Address of the deployed KimchiProvenance contract on Monad Testnet.
# Filled in after the first deployment.
NEXT_PUBLIC_PROVENANCE_CONTRACT=

# Absolute origin used to build the QR code target for a Batch Passport.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
