# Server-side / Hardhat only. Copy to `.env`, which Git ignores.
# Nothing in this file may be prefixed with NEXT_PUBLIC_.

# Monad Testnet JSON-RPC endpoint used for deploying and seeding.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer / prototype verifier key.
#
# Use a DISPOSABLE testnet-only key holding nothing but faucet MON.
# Never commit a real key. Never reuse a mainnet key. Never expose this value
# through NEXT_PUBLIC_. Hardhat reads it through `configVariable`, so it is
# resolved only when a network connection opens and is never printed by
# `hardhat config show` or any config dump.
#
# Alternative: leave this unset and store the key in the encrypted Hardhat
# keystore instead — `npx hardhat keystore set PRIVATE_KEY`.
PRIVATE_KEY=
