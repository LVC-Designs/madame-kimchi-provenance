{
  "name": "madame-kimchi-provenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:lib": "node --test 'src/lib/*.test.ts'",
    "typecheck": "tsc --noEmit && npm run typecheck:chain",
    "typecheck:chain": "hardhat build && tsc --noEmit -p tsconfig.hardhat.json",
    "chain:compile": "hardhat build",
    "chain:test": "hardhat test",
    "chain:deploy": "hardhat ignition deploy ignition/modules/KimchiProvenance.ts --network monadTestnet",
    "chain:abi": "hardhat build && node scripts/export-abi.ts",
    "chain:export": "node scripts/export-deployment.ts",
    "demo:seed": "hardhat run scripts/seed-demo-batch.ts --network monadTestnet",
    "chain:clean": "hardhat clean",
    "chain:deploy:sandbox": "hardhat ignition deploy ignition/modules/KimchiProvenanceSandbox.ts --network monadTestnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.11",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "hardhat": "^3.11.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
